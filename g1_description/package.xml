<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_description</name>
  <version>0.1.0</version>
  <description>Installs the Hospital_G1 robot model (Unitree G1 29-DoF rev 1.0 + BrainCo Revo2 hands) from g1-brainco-description/ and launches robot_state_publisher.</description>
  <maintainer email="bangrak2000@gmail.com">rakshith</maintainer>
  <license>BSD-3-Clause AND Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
