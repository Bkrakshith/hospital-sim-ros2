# RViz2 (Humble) layout for the hospital SLAM survey screen recording (1920x1080, dark).
# Left: whole-building top-down view (SLAM map growing, live 2-D scan, MID-360 cloud, Nav2 plan, robot trail,
# route waypoints, robot arrow). Right dock: the robot's head camera; under it the Views panel, which the recording
# covers with survey_caption_bar.py --panel (route progress + legend). No toolbar.
#   DISPLAY=... rviz2 -d $(ros2 pkg prefix g1_navigation)/share/g1_navigation/rviz/slam_survey.rviz
# Topics: /map, /scan, /livox/lidar, /plan, /survey/trail, /survey/route, /survey/robot_pose (survey_runner.py),
# /robot_description, /tf, /g1/head_camera/image_raw.
Panels:
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Update Topic:
        Value: /map_updates
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: MID-360 cloud
      Enabled: true
      Alpha: 0.35
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.2
        Min Value: 0
        Value: false
      Axis: Z
      Color Transformer: AxisColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.05
      Style: Points
      Topic:
        Value: /livox/lidar
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: 2-D scan
      Enabled: true
      Alpha: 1
      Color: 255; 40; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.14
      Style: Flat Squares
      Topic:
        Value: /scan
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Robot trail
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 0; 190; 255
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.22
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Value: /survey/trail
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Nav2 plan
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 60; 230; 100
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.12
      Offset: {X: 0, Y: 0, Z: 0.01}
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Route waypoints
      Enabled: true
      Namespaces:
        route_line: true
        waypoints: true
      Topic:
        Value: /survey/route
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: G1 model
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: false
        pelvis:
          Value: true
      Marker Scale: 2.5
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Robot
      Enabled: true
      Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Color: 255; 210; 40
      Head Length: 0.9
      Head Radius: 0.65
      Shaft Length: 1.1
      Shaft Radius: 0.28
      Shape: Arrow
      Topic:
        Value: /survey/robot_pose
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: "Head camera (forward view)"
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Value: /g1/head_camera/image_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 22; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools: []
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Scale: 13.6
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: -8.6
      Y: 6.2
    Saved: ~
Window Geometry:
  "Head camera (forward view)":
    collapsed: false
  Height: 1073
  Views:
    collapsed: false
  Hide Left Dock: true
  Hide Right Dock: false
  QMainWindow State: 
  Width: 1920
  X: 0
  Y: 0
