<?xml version="1.0"?>
<package format="3">
  <name>g1_perception</name>
  <version>0.1.0</version>
  <description>Instrument detection (YOLO11-OBB ONNX or ground-truth from /sim/objects), grasp pose from OBB + depth,
    surgeon-hand detection (MediaPipe or ground truth) for the scrub-nurse mission</description>
  <maintainer email="bangrak2000@gmail.com">rakshith</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
